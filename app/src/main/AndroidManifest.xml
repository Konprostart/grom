<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- S4-R004: the permission is declared by the server role. Clients just
         need a matching signature; they declare nothing (S4-R020). -->
    <permission
        android:name="app.grom.sdk.ipc.BIND_GROMSERVER"
        android:protectionLevel="signature" />

    <!-- extractNativeLibs is deliberate (D34): the Node runtime is packaged in
         jniLibs and must exist as a real file under nativeLibraryDir so it can
         be execve()'d. With the AGP 8 default (false) the libraries stay inside
         the APK and can only be mmap()'d — no process could start. -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_grom"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.Grom">

        <activity
            android:name=".GromActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
