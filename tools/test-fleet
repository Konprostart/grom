#!/usr/bin/env bash
# test-fleet — protocol tests for tools/grom-fleet.
#
# The tests start a real HTTP server on loopback and speak the same two
# endpoints a phone serves, so a change to the canonical signature string or
# the login flow fails here before it fails against a device.
set -euo pipefail

cd "$(dirname "$0")/.." || exit 1

if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA="$JAVA_HOME/bin/java"
elif command -v java >/dev/null 2>&1; then
  JAVA="java"
else
  echo "test-fleet: a JDK 17 is required (set JAVA_HOME or put java on PATH)" >&2
  exit 2
fi

echo "== test-fleet =="
exec "$JAVA" --source 17 tools/fleet/GromFleet.java --self-test
